{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "co-ai",
  "account_id": "6081c65734701e00a8ef4554443e2688",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "co-ai.xlogic.cc", "custom_domain": true }],
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "MCP_DEBUG_LOGS": "false",
    "CF_ACCESS_TEAM_DOMAIN": "x1x3.cloudflareaccess.com",
    "CF_ACCESS_AUD": "11906f98a3bfe8404d4a3e26e17659dd00b3bdabf8a2a39a51d4e709d880b03a"
  },
  "durable_objects": { "bindings": [{ "name": "EVENTS_LIVE", "class_name": "EventsLive" }] },
  "migrations": [{ "tag": "v1-events-live", "new_sqlite_classes": ["EventsLive"] }],
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "co-ai",
    "database_id": "0a23f076-441c-4fd3-aaa4-e28250c91297",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "co-ai-files" }],
  "assets": { "directory": "./public", "binding": "DOCS", "run_worker_first": true, "html_handling": "none" },
  "observability": { "enabled": true }
}
